{
  "name": "devsaheb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender && npm run og && npm run check:links",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "start": "node --env-file-if-exists=.env server.js",
    "preview": "npm run build && node server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run typecheck && npm run build && npm run audit:bundle",
    "og": "node scripts/og.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:perf": "node scripts/audit-perf.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "audit": "npm run audit:bundle && npm run audit:a11y && npm run audit:perf",
    "release": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@measured/puck": "^0.20.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "framer-motion": "^13.0.0",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.5.0",
    "satori": "^0.29.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
