# Deploy to the document root, which should point at dist/client.
#
# The cPanel Node.js app is configured separately with Application URL = /api,
# so Passenger only ever sees API traffic. Every public page is a static file
# Apache serves directly, with no Node process in the request path.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Trailing slashes create duplicate URLs for the same page, which splits
  # ranking signals. Redirect once, permanently. Real directories are exempt.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/$ /$1 [R=301,L,QSA]

  # /services -> /services/index.html, without exposing the filename.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build output. Safe to cache forever - a new build means a new URL.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Unhashed root assets (favicons, OG card). Long enough to help, short enough
  # that a brand change is not stuck in caches for a year.
  <FilesMatch "\.(png|svg|ico|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # HTML must revalidate, or pages edited through the admin stay invisible.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
